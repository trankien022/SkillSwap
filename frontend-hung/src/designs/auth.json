ify-center gap-2.5 transition-colors\" type=\"button\">\n<svg class=\"w-3.5 h-3.5 flex-shrink-0\" viewbox=\"0 0 23 23\">\n<path d=\"M1 1h10v10H1z\" fill=\"#f35325\"></path>\n<path d=\"M12 1h10v10H12z\" fill=\"#81bc06\"></path>\n<path d=\"M1 12h10v10H1z\" fill=\"#05a6f0\"></path>\n<path d=\"M12 12h10v10H12z\" fill=\"#ffba08\"></path>\n</svg>\n<span>Microsoft 365</span>\n</button>\n</div>\n<!-- Divider -->\n<div class=\"relative flex items-center justify-center mb-6\">\n<div class=\"w-full h-px bg-outline-variant\"></div>\n<span class=\"absolute px-3 bg-surface-container-lowest text-[11px] font-medium text-on-surface-variant uppercase tracking-wider\">hoặc qua email</span>\n</div>\n<!-- REGISTER TAB -->\n<div class=\"space-y-4\" id=\"register-pane\">\n<div class=\"space-y-1.5\">\n<label class=\"block text-xs font-semibold text-on-surface\" for=\"reg-fullname\">\n                Họ và tên <span class=\"text-error\">*</span>\n</label>\n<input class=\"w-full h-10 px-3.5 rounded-lg border border-outline bg-surface-container-lowest text-sm text-on-surface placeholder:text-slate-400 focus:outline-none focus:border-secondary focus:ring-1 focus:ring-secondary transition-all\" id=\"reg-fullname\" placeholder=\"Nguyễn Văn A\" type=\"text\"/>\n</div>\n<div class=\"space-y-1.5\">\n<div class=\"flex items-center justify-between\">\n<label class=\"block text-xs font-semibold text-on-surface\" for=\"reg-email\">\n                  Email sinh viên hoặc cá nhân <span class=\"text-error\">*</span>\n</label>\n<span class=\"text-[11px] text-emerald-600 font-medium hidden\" id=\"edu-badge\">Duyệt tự động (.edu)</span>\n</div>\n<input class=\"w-full h-10 px-3.5 rounded-lg border border-outline bg-surface-container-lowest text-sm text-on-surface placeholder:text-slate-400 focus:outline-none focus:border-secondary focus:ring-1 focus:ring-secondary transition-all\" id=\"reg-email\" data-oninput=\"detectEduDomain(this.value)\" placeholder=\"ten.sinhvien@hcmut.edu.vn\" type=\"email\"/>\n</div>\