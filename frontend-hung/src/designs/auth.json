ord\"/>\n<button class=\"absolute right-3 top-2.5 text-slate-400 hover:text-on-surface focus:outline-none\" data-onclick=\"togglePasswordVisibility('reg-password', this)\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">visibility</span>\n</button>\n</div>\n<!-- Clean Password Gauge -->\n<div class=\"grid grid-cols-4 gap-1 pt-1\">\n<div class=\"h-1 rounded-full bg-slate-200 transition-colors\" id=\"meter-1\"></div>\n<div class=\"h-1 rounded-full bg-slate-200 transition-colors\" id=\"meter-2\"></div>\n<div class=\"h-1 rounded-full bg-slate-200 transition-colors\" id=\"meter-3\"></div>\n<div class=\"h-1 rounded-full bg-slate-200 transition-colors\" id=\"meter-4\"></div>\n</div>\n</div>\n<div class=\"pt-1\">\n<label class=\"flex items-start gap-2.5 cursor-pointer text-xs text-on-surface-variant leading-relaxed select-none\">\n<input class=\"mt-0.5 rounded border-outline text-primary focus:ring-primary accent-primary cursor-pointer\" id=\"academic-pledge\" type=\"checkbox\"/>\n<span>Tôi đồng ý với <a class=\"text-secondary hover:underline\" href=\"#\">Điều khoản Dịch vụ</a> và cam kết tuân thủ <a class=\"text-secondary hover:underline\" href=\"#\">Quy tắc Liêm chính Học thuật</a>.</span>\n</label>\n</div>\n<button class=\"w-full h-10 mt-2 rounded-lg bg-primary hover:bg-primary-container text-on-primary font-medium text-xs flex items-center justify-center gap-2 shadow-xs transition-all\" data-onclick=\"simulateRegisterSubmit()\" type=\"button\">\n<span>Tạo tài khoản &amp; Nhận 50 Credit</span>\n<span class=\"material-symbols-outlined text-[16px]\">arrow_forward</span>\n</button>\n</div>\n<!-- LOGIN TAB (Hidden by default) -->\n<div class=\"space-y-4 hidden\" id=\"login-pane\">\n<div class=\"space-y-1.5\">\n<label class=\"block text-xs font-semibold text-on-surface\" for=\"login-identifier\">\n                Email tài khoản <span class=\"text-error\">*</span>\n</label>\n<input class=\"w-full h-10 px-3.5 rounded-lg border border-outline bg-surface-container-lowest text-sm text-on-surface placeholder:text-slate-400 focus:outline-none focus:border-secondary focus:ring-1 focus:ring-secondary transition-all\" id=\"login-identifier\" placeholder=\"ten.sinhvien@hcmut.edu.vn\" type=\"text\"/>\n</div>\n<div class=\"space-y-1.5\">\n<div class=\"flex items-center justify-between\">\n<label class=\"block text-xs font-semibold text-on-surface\" for=\"login-password\">\n                  Mật khẩu <span class=\"text-error\">*</span>\n</label>\n<a class=\"text-[11px] text-secondary hover:underline font-medium\" href=\"#\">Quên mật khẩu?</a>\n</div>\n<div class=\"relative\">\n<input class=\"w-full h-10 pl-3.5 pr-10 rounded-lg border border-outline bg-surface-container-lowest text-sm text-on-surface placeholder:text-slate-400 focus:outline-none focus:border-secondary focus:ring-1 focus:ring-secondary transition-all\" id=\"login-password\" placeholder=\"••••••••••••\" type=\"password\"/>\n<button class=\"absolute right-3 top-2.5 text-slate-400 hover:text-on-surface focus:outline-none\" data-onclick=\"togglePasswordVisibility('login-password', this)\" type=\"button\">\n<span class=\"material-symbols-outlined text-[18px]\">visibility</span>\n</button>\n</div>\n</div>\n<div class=\"flex items-center justify-between pt-1\">\n<label class=\"flex items-center gap-2 cursor-pointer text-xs text-on-surface-variant select-none\">\n<input checked=\"\" class=\"rounded border-outline text-primary focus:ring-primary accent-primary cursor-pointer\" id=\"remember-device\" type=\"checkbox\"/>\n<span>Ghi nhớ 30 ngày</span>\n</label>\n<span class=\"text-[11px] text-slate-400 flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[14px]\">shield</span> Bảo mật OTP\n              </span>\n</div>\n<button class=\"w-full h-10 mt-2 rounded-lg bg-primary hover:bg-primary-container text-on-primary font-medium text-xs flex items-center justify-center gap-2 shadow-xs transition-all\" data-onclick=\"simulateLoginSubmit()\" type=\"button\">\n<span>Đăng nhập</span>\n<span class=\"material-symbols-outlined text-[16px]\">arrow_forward</span>\n</button>\n</div>\n<!-- Alert message box -->\n<div class=\"hidden mt-4 p-3 rounded-lg text-xs flex items-center gap-2 transition-all\" id=\"auth-alert\">\n<span class=\"material-symbols-outlined text-[18px]\" id=\"auth-alert-icon\"></span>\n<span id=\"auth-alert-msg\"></span>\n</div>\n<!-- Minimal footnote support link -->\n<div class=\"mt-6 pt-5 border-t border-slate-100 flex items-center justify-between text-xs text-on-surface-variant\">\n<span>Cần trợ giúp xác minh thẻ sinh viên?</span>\n<a class=\"text-secondary font-medium hover:underline\" href=\"#\">Liên hệ tư vấn viên</a>\n</div>\n</div>\n</div>\n</div>\n</main>\n<!-- Clean, Minimal Footer -->\n<footer class=\"w-full border-t border-outline-variant/60 bg-surface-container-lowest py-6\">\n<div class=\"max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-on-surface-variant\">\n<div>\n        © 2025 SkillSwap Vietnam. Nền tảng chia sẻ kỹ năng sinh viên.\n      </div>\n<div class=\"flex items-center gap-6\">\n<a class=\"hover:text-on-surface transition-colors\" href=\"#\">Điều khoản dịch vụ</a>\n<a class=\"hover:text-on-surface transition-colors\" href=\"#\">Quy tắc liêm chính</a>\n<a class=\"hover:text-on-surface transition-colors\" href=\"#\">Bảo mật thông tin</a>\n<div class=\"flex items-center gap-1 pl-2 border-l border-slate-200\">\n<span class=\"text-on-surface font-medium\">VN</span>\n<span class=\"text-slate-300\">/</span>\n<a class=\"text-slate-400 hover:text-on-surface\" href=\"#\">EN</a>\n</div>\n</div>\n</div>\n</footer>\n\n"