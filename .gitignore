# Local dev artefacts
apps/web/dev.err
# Source assets (work-in-progress logos) — only the curated copy under apps/web/public/ is committed
logo/
# This repo uses pnpm. A stray `npm install` writes a lockfile the project does
# not consume; ignore it rather than leave it as untracked noise.
package-lock.json

# Locally installed agent tools and generated code graphs.
.agents/
.codex/
**/graphify-out/

# Playwright MCP browser-session scratch (page snapshots, console logs).
.playwright-mcp/

# Local Android build output and Office lock files.
apps/mobile/build-*.apk
~$*.pptx

# ngrok: keep the committed ngrok.yml (config only) and ignore any local copies
# that might hold an authtoken. The token itself lives in .env (already ignored).
ngrok.local.yml
*.ngrok.yml
!ngrok.yml
