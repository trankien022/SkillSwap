# SkillSwap local environment — copy to `.env` at the repo root (never committed).
# Consumed by apps/api and apps/gateway via dotenv.

# ── Shared database (docker-compose: postgres:17, one database, seven schemas) ──
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=skillswap
DATABASE_PASSWORD=skillswap_dev
# Per-module credentials follow ADR-007. Defaults: user skillswap_<schema>,
# password DATABASE_PASSWORD. Override per module if needed, e.g.
# DATABASE_WALLET_LEDGER_USER / DATABASE_WALLET_LEDGER_PASSWORD.
# Schemas: admin_operation, student_verification, skill_verification,
#          account_profile, live_class, wallet_ledger, schedule

# ── Message broker (ADR-013: RabbitMQ, transactional outbox → events) ──
RABBITMQ_URL=amqp://guest:guest@localhost:5672
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=20
MAX_DELIVERY_ATTEMPTS=5

# ── API (apps/api, port 4001) ──
API_PORT=4001
AUTH_MODE=strict # pair with AUTH_REQUIRED=true for mobile/API development
# FR-001 auth (ADR-016): RS256 access-token issuance. Same key pair the gateway verifies.
JWT_PRIVATE_KEY_PATH=../../.secrets/jwt-private.pem # relative to apps/api cwd; run `pnpm keys:gen`
ACCESS_TOKEN_TTL_SECONDS=900
# FR-011 (ADR-020): self-hosted Jitsi room access. The API signs short-lived
# room JWTs with these; Prosody accepts only this app id/secret.
JITSI_APP_ID=skillswap
JITSI_APP_SECRET=skillswap_jitsi_dev_secret
JITSI_JICOFO_PASSWORD=skillswap_jicofo_dev_password
JITSI_JVB_PASSWORD=skillswap_jvb_dev_password
JITSI_DOMAIN=localhost:8443
JITSI_PUBLIC_URL=https://localhost:8443
JITSI_TOKEN_TTL_SECONDS=3600
JITSI_OPEN_MINUTES=15
# AC-035: shared secret the Jitsi presence webhook must send. Empty refuses all presence,
# so leave it set in any environment where classes may complete from an empty room.
JITSI_WEBHOOK_SECRET=skillswap_jitsi_webhook_dev_secret
# FR-016 (W3 C1): minutes before starts_at the "class starting soon" reminder fires. 15 matches
# the room-access window so the reminder arrives when the door is usable.
CLASS_REMINDER_OFFSET_MINUTES=15
LOG_LEVEL=info

# ── FR-002 documents (ADR-023): S3-compatible object storage ──
# Works with AWS S3, MinIO or any S3-compatible endpoint. Uploads use
# pre-signed PUT URLs (SigV4); object metadata lives in Postgres.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=skillswap-documents
S3_ACCESS_KEY_ID=skillswap
S3_SECRET_ACCESS_KEY=skillswap_dev_secret
S3_FORCE_PATH_STYLE=true # true for MinIO / path-style endpoints
S3_UPLOAD_TTL_SECONDS=900
S3_MAX_UPLOAD_BYTES=10485760
S3_ALLOWED_CONTENT_TYPES=application/pdf,image/png,image/jpeg

# ── Gateway (apps/gateway, port 4000) ──
GATEWAY_PORT=4000
API_INTERNAL_URL=http://localhost:4001
AUTH_REQUIRED=true # pair with AUTH_MODE=strict; false/off is anonymous-only API mode
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY_PATH=../../.secrets/jwt-public.pem # relative to apps/gateway; run `pnpm keys:gen`
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Browser clients other than the Next.js app call the gateway cross-origin.
# The Next.js app proxies through next.config.ts rewrites and needs nothing here;
# Expo Web (port 8081, or 8082 when 8081 is taken) does. Comma-separated explicit
# origins — never "*", since the gateway injects trusted identity headers downstream.
# CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:3000,http://localhost:3001

# ── Web (apps/web, port 3000) ──
# Base URL the browser uses to reach the gateway for health probes.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ── FR-008 (ADR-033): SePay Payment Gateway (hosted checkout + IPN) ──
# Sandbox is a fully isolated test environment and needs no bank account.
# Credentials come from my.sepay.vn → Payment Gateway → Register → Sandbox.
# SEPAY_MERCHANT_ID and SEPAY_SECRET_KEY are secrets: set them in `.env` only.
SEPAY_ENVIRONMENT=sandbox
SEPAY_CHECKOUT_HOST=https://pay-sandbox.sepay.vn
SEPAY_REST_BASE_URL=https://pgapi-sandbox.sepay.vn
# Where SePay redirects the browser after checkout; must be publicly reachable
# (use the ngrok dev domain below — SePay rejects localhost and internal IPs).
SEPAY_RETURN_URL=
# Extra browser origins a payer's own client may be sent back to (comma
# separated). SEPAY_RETURN_URL's origin is always allowed; this only widens it,
# e.g. so the web app on http://localhost:3000 can send the payer to
# /vi/payment/result while the configured return URL is the public ngrok domain.
# Never inferred from a request header — that would make it an open redirect.
SEPAY_RETURN_URL_ALLOWED_ORIGINS=
# SEPAY_MERCHANT_ID=
# SEPAY_SECRET_KEY=
# Off by default; the stub reconciler is not production-ready (see ADR-033).
SEPAY_RECON_ENABLED=false
# How often a pass runs, and how old a pending intent must be before it is
# re-queried — the minimum age keeps a checkout the payer is still on out of it.
SEPAY_RECON_INTERVAL_MS=300000
SEPAY_RECON_MIN_AGE_MS=900000

# ── Local payment tunnel (ngrok) ──
# Reserved free dev domain that exposes the API (:4001) to SePay's IPN.
# Find it at https://dashboard.ngrok.com/domains — it stays the same across runs
# so the IPN URL only has to be configured in SePay once. Non-secret.
# Keep it in sync with the `url` in ngrok.yml.
NGROK_DOMAIN=
# Secret. Paste the token from https://dashboard.ngrok.com/get-started/your-authtoken.
# `pnpm dev` and scripts/start-ngrok.ps1 read it from .env and never print it.
# NGROK_AUTHTOKEN=
