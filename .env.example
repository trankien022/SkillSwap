# SkillSwap local environment — copy to `.env` at the repo root (never committed).
# Consumed by apps/api and apps/gateway via dotenv.

# ── Shared database (docker-compose: postgres:17, one database, seven schemas) ──
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=skillswap
DATABASE_PASSWORD=skillswap_dev
# Per-module credentials follow ADR-007. Defaults: user skillswap_<schema>,
# password DATABASE_PASSWORD. Override per module if needed, e.g.
# DATABASE_WALLET_LEDGER_USER / DATABASE_WALLET_LEDGER_PASSWORD.
# Schemas: admin_operation, student_verification, skill_verification,
#          account_profile, live_class, wallet_ledger, schedule

# ── TLS and pool sizing (leave off/false for the local docker server) ──
# Managed Postgres (Neon, Aiven, …) rejects plaintext connections, so set
# DATABASE_SSL=true there. Verification defaults on; only turn it off for a host
# whose CA is genuinely unavailable, since it defeats the point of TLS.
DATABASE_SSL=false
DATABASE_SSL_VERIFY=true
# Connections per module. Seven modules each open their own pool (ADR-007), so
# the total is 7 × this value. Raise it above 10 on Neon only if you also raise
# the compute size (0.25 CU allows 104 connections).
DATABASE_POOL_MAX=10

# ── Managed-database bootstrap (only needed off Docker) ──
# `pnpm db:bootstrap` creates the seven roles and schemas. Docker does this in
# docker/postgres/init/*.sql on first boot; a managed host has no such hook.
# Use a role allowed to CREATE ROLE and CREATE SCHEMA — on Neon, `neondb_owner`.
# Leave unset locally; the script refuses to run without it.
# DATABASE_ADMIN_USER=
# DATABASE_ADMIN_PASSWORD=

# ── Message broker (ADR-013: RabbitMQ, transactional outbox → events) ──
RABBITMQ_URL=amqp://guest:guest@localhost:5672
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=20
MAX_DELIVERY_ATTEMPTS=5

# ── API (apps/api, port 4001) ──
API_PORT=4001
AUTH_MODE=strict # pair with AUTH_REQUIRED=true for mobile/API development
# FR-001 auth (ADR-016): RS256 access-token issuance. Same key pair the gateway verifies.
JWT_PRIVATE_KEY_PATH=../../.secrets/jwt-private.pem # relative to apps/api cwd; run `pnpm keys:gen`
ACCESS_TOKEN_TTL_SECONDS=900
# FR-011 (ADR-039): hosted Jitsi via JaaS (8x8). The API signs a short-lived RS256 room
# JWT per participant with the API private key; there is no shared secret any more.
# Setup: console.8x8.vc → create an AppID, then API keys → generate a key and download
# the PEM. JITSI_KEY_ID is the short id shown next to the key; JaaS expects the JWT `kid`
# as "<appId>/<keyId>", which the issuer builds. Free tier: up to 25 MAU.
JITSI_APP_ID=vpaas-magic-cookie-your-app-id
JITSI_KEY_ID=your-key-id
# Absolute, or relative to apps/api's cwd. A missing key fails at boot rather than
# minting tokens the provider rejects.
JITSI_PRIVATE_KEY_PATH=../../.secrets/jaas-private.pem
# Carries the tenant so `https://${JITSI_DOMAIN}/${room}` is a valid JaaS meeting URL.
JITSI_DOMAIN=8x8.vc/vpaas-magic-cookie-your-app-id
JITSI_TOKEN_TTL_SECONDS=3600
JITSI_OPEN_MINUTES=15
# AC-035: the JaaS endpoint "signing secret" (JaaS Console → Webhooks → Reveal secret),
# used to verify X-Jaas-Signature. Empty refuses all presence, so leave it set in any
# environment where classes may complete from an empty room.
JITSI_WEBHOOK_SECRET=
# FR-016 (W3 C1): minutes before starts_at the "class starting soon" reminder fires. 15 matches
# the room-access window so the reminder arrives when the door is usable.
CLASS_REMINDER_OFFSET_MINUTES=15
LOG_LEVEL=info

# ── FR-002 documents (ADR-038): Cloudinary ──
# Uploads are a signed multipart POST straight from the browser to Cloudinary; the API
# only mints the signature, so document bytes never pass through it.
# Setup: cloudinary.com → Console → Dashboard shows cloud name / API key / API secret.
# Free tier: 25 credits/month (1 credit = 1 GB stored OR 1 GB bandwidth OR 1,000
# transforms). Free plan caps a single file at 10 MB, which is why the limit below is 10 MB.
# NOTE: free accounts block *delivery* of PDFs by default. Enable Console → Settings →
# Security → "Allow delivery of PDF and ZIP files" if a reviewer must open a PDF.
CLOUDINARY_CLOUD_NAME=your-cloud-name
# Both are secrets in practice: keep them in `.env` only.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Advisory client-side guard only — Cloudinary publishes no upload-signature TTL.
CLOUDINARY_UPLOAD_TTL_SECONDS=900
CLOUDINARY_MAX_UPLOAD_BYTES=10485760
CLOUDINARY_ALLOWED_CONTENT_TYPES=application/pdf,image/png,image/jpeg

# ── Gateway (apps/gateway, port 4000) ──
GATEWAY_PORT=4000
API_INTERNAL_URL=http://localhost:4001
AUTH_REQUIRED=true # pair with AUTH_MODE=strict; false/off is anonymous-only API mode
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY_PATH=../../.secrets/jwt-public.pem # relative to apps/gateway; run `pnpm keys:gen`
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Browser clients other than the Next.js app call the gateway cross-origin.
# The Next.js app proxies through next.config.ts rewrites and needs nothing here;
# Expo Web (port 8081, or 8082 when 8081 is taken) does. Comma-separated explicit
# origins — never "*", since the gateway injects trusted identity headers downstream.
# CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:3000,http://localhost:3001

# ── Web (apps/web, port 3000) ──
# Base URL the browser uses to reach the gateway for health probes.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ── FR-008 (ADR-033): SePay Payment Gateway (hosted checkout + IPN) ──
# Sandbox is a fully isolated test environment and needs no bank account.
# Credentials come from my.sepay.vn → Payment Gateway → Register → Sandbox.
# SEPAY_MERCHANT_ID and SEPAY_SECRET_KEY are secrets: set them in `.env` only.
SEPAY_ENVIRONMENT=sandbox
SEPAY_CHECKOUT_HOST=https://pay-sandbox.sepay.vn
SEPAY_REST_BASE_URL=https://pgapi-sandbox.sepay.vn
# Where SePay redirects the browser after checkout; must be publicly reachable
# (use the ngrok dev domain below — SePay rejects localhost and internal IPs).
SEPAY_RETURN_URL=
# Extra browser origins a payer's own client may be sent back to (comma
# separated). SEPAY_RETURN_URL's origin is always allowed; this only widens it,
# e.g. so the web app on http://localhost:3000 can send the payer to
# /vi/payment/result while the configured return URL is the public ngrok domain.
# Never inferred from a request header — that would make it an open redirect.
SEPAY_RETURN_URL_ALLOWED_ORIGINS=
# SEPAY_MERCHANT_ID=
# SEPAY_SECRET_KEY=
# Off by default; the stub reconciler is not production-ready (see ADR-033).
# Enabling it needs a REAL Order API key, which is NOT SEPAY_SECRET_KEY: that one
# is the Payment Gateway signing secret and the Order API answers 401 to it.
SEPAY_RECON_ENABLED=false
# How often a pass runs, and how old a pending intent must be before it is
# re-queried — the minimum age keeps a checkout the payer is still on out of it.
SEPAY_RECON_INTERVAL_MS=300000
SEPAY_RECON_MIN_AGE_MS=900000

# ── Credit exchange rate (BR-027) ──
# VND per credit for a wallet top-up. 1000 keeps every existing deployment pricing
# exactly as the old hardcoded constant did. Each intent stores the rate it was
# created under, so changing this never re-prices money already in flight.
# Must be a positive integer; the API refuses to boot otherwise.
VND_PER_CREDIT=1000

# ── Local payment tunnel (ngrok) ──
# Reserved free dev domain that exposes the API (:4001) to SePay's IPN.
# Find it at https://dashboard.ngrok.com/domains — it stays the same across runs
# so the IPN URL only has to be configured in SePay once. Non-secret.
# Keep it in sync with the `url` in ngrok.yml.
NGROK_DOMAIN=
# Secret. Paste the token from https://dashboard.ngrok.com/get-started/your-authtoken.
# `pnpm dev` and scripts/start-ngrok.ps1 read it from .env and never print it.
# NGROK_AUTHTOKEN=
