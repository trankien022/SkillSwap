{
  "name": "skillswap",
  "version": "0.1.0",
  "private": true,
  "description": "SkillSwap — student skill marketplace for verified learners and verified student teachers",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @skillswap/contracts build && pnpm -r --parallel dev",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @skillswap/contracts build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:arch": "depcruise --config .dependency-cruiser.cjs --output-type err-long apps packages",
    "verify": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm test:arch",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm build && node scripts/migrate.mjs",
    "keys:gen": "node scripts/generate-dev-keys.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "dependency-cruiser": "^16.9.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
