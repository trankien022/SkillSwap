Rel(Administrator, SkillSwapSystem, "Verify students, manage verifiers, handle operations", $techn="", $tags="", $link="")
Rel(Learner, Privatedocumentstorage, "Upload document bytes using API-issued URL", $techn="Presigned HTTPS PUT", $tags="", $link="")
Rel(Teacher, Jitsiselfhosted, "Teaches live class", $techn="HTTPS/WebRTC", $tags="", $link="")
Rel(Learner, Jitsiselfhosted, "Attends live class", $techn="HTTPS/WebRTC", $tags="", $link="")
Rel(SkillSwapSystem, Jitsiselfhosted, "Online classroom access via", $techn="HTTPS/WebRTC", $tags="", $link="")
Rel(SkillSwapSystem, Privatedocumentstorage, "Private verification documents", $techn="Presigned HTTPS PUT", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml
