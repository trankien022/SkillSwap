@startuml
title System Context — SkillSwap (C4 Level 1)

set separator none
top to bottom direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>

' Presentation only: model elements and relationships come from workspace.dsl.
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 45
skinparam footerFontSize 12
skinparam titleFontSize 20
UpdateElementStyle("person", $bgColor="#0F172A", $fontColor="#FFFFFF", $borderColor="#0F172A", $legendText="Person")
UpdateElementStyle("system", $bgColor="#047857", $fontColor="#FFFFFF", $borderColor="#047857", $legendText="Software system in scope")
UpdateElementStyle("external_system", $bgColor="#64748B", $fontColor="#FFFFFF", $borderColor="#64748B", $legendText="Supporting software system")
UpdateElementStyle("container", $bgColor="#047857", $fontColor="#FFFFFF", $borderColor="#047857", $legendText="Application or data store")
UpdateRelStyle($lineColor="#475569", $textColor="#334155")
AddElementTag("Demo", $bgColor="#F1F5F9", $fontColor="#0F172A", $borderColor="#64748B", $legendText="Demonstration client (local booking data)")

together {
  Person(Learner, "Learner", $descr="[Person]\nBooks classes and attends online lessons.", $tags="", $link="")
  Person(Teacher, "Teacher", $descr="[Person]\nVerified student with approved skills who publishes and teaches classes.", $tags="", $link="")
  Person(Verifier, "Verifier", $descr="[Person]\nReviews teaching evidence within assigned expertise.", $tags="", $link="")
  Person(Administrator, "Administrator", $descr="[Person]\nReviews student proof and manages Verifier access.", $tags="", $link="")
}

System_Ext(Onlineclassroom, "Online classroom", $descr="[Supporting software system]\nHosts live lessons for authorized Learners and Teachers.", $tags="", $link="")
System(SkillSwap, "SkillSwap", $descr="[Software system]\nHelps students verify skills, book classes and pay with internal credits.", $tags="", $link="")

Rel(Learner, SkillSwap, "Books classes and uses wallet credits")
Rel(Teacher, SkillSwap, "Submits skills and manages teaching")
Rel(Verifier, SkillSwap, "Reviews teaching evidence")
Rel(Administrator, SkillSwap, "Approves students and manages Verifiers")
Rel(SkillSwap, Onlineclassroom, "Authorizes access to booked lessons")
Rel(Learner, Onlineclassroom, "Attends booked lessons")
Rel(Teacher, Onlineclassroom, "Teaches booked lessons")

SHOW_LEGEND()
footer Current backend capabilities. Web/mobile booking and wallet checkout are demonstrations.\nLearner and Teacher are capabilities of the same student account.
@enduml
