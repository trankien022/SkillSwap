@startuml
title C4-L0 System Context — SkillSwap (C4 standard Level 1)

set separator none
top to bottom direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>

' Presentation only: model elements and relationships come from workspace.dsl.
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 45
skinparam footerFontSize 12
skinparam titleFontSize 20
UpdateElementStyle("person", $bgColor="#0F172A", $fontColor="#FFFFFF", $borderColor="#0F172A", $legendText="Person")
UpdateElementStyle("system", $bgColor="#047857", $fontColor="#FFFFFF", $borderColor="#047857", $legendText="Software system in scope")
UpdateElementStyle("external_system", $bgColor="#64748B", $fontColor="#FFFFFF", $borderColor="#64748B", $legendText="Supporting software system")
UpdateElementStyle("container", $bgColor="#047857", $fontColor="#FFFFFF", $borderColor="#047857", $legendText="Application or data store")
UpdateRelStyle($lineColor="#475569", $textColor="#334155")

together {
  Person(User, "User", $descr="[Person]\nA student account that can learn and, when eligible, teach.", $tags="", $link="")
  Person(Verifier, "Verifier", $descr="[Person]\nReviews teaching evidence within assigned expertise.", $tags="", $link="")
  Person(Admin, "Admin", $descr="[Person]\nReviews student proof and manages Verifier access.", $tags="", $link="")
}

System_Ext(Onlineclassroom, "Online classroom", $descr="[Supporting software system]\nHosts live lessons for users who are learning or teaching.", $tags="", $link="")
System_Ext(Paymentgateway, "SePay Payment Gateway", $descr="[Supporting software system]\nProcesses cash top-ups through a hosted checkout page and reports the outcome by IPN. Payout is not implemented.", $tags="", $link="")
System(SkillSwap, "SkillSwap", $descr="[Software system]\nHelps students verify skills, book classes and pay with internal credits.", $tags="", $link="")

Rel(User, SkillSwap, "Learns, books classes and may publish or teach when eligible")
Rel(Verifier, SkillSwap, "Reviews teaching evidence")
Rel(Admin, SkillSwap, "Approves students and manages Verifiers")
Rel(SkillSwap, Onlineclassroom, "Authorizes access to booked lessons")
Rel(User, Onlineclassroom, "Attends or teaches a booked lesson")
Rel(SkillSwap, Paymentgateway, "Starts top-ups and receives the outcome notification")

SHOW_LEGEND()
footer Current backend capabilities. Web and mobile booking screens post to the real hold and confirm endpoints; the payment provider is still represented as an external dependency.\nBackend uses the SePay Payment Gateway adapter (hosted checkout + IPN, ADR-033); payout is not implemented.
@enduml
