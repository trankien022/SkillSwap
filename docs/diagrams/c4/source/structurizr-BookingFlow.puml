@startuml
title <size:24>Dynamic View: SkillSwap System</size>\n<size:24>Current backend booking: confirmed precedes asynchronous settlement</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

System_Boundary("SkillSwapSystem_boundary", "SkillSwap System", $tags="") {
  ContainerDb(SkillSwapSystem.Database, "Database", $techn="PostgreSQL", $descr="One skillswap database; seven module schemas, per-module credentials; no cross-schema joins/FKs", $tags="", $link="")
  ContainerQueue(SkillSwapSystem.MessageBroker, "Message Broker", $techn="RabbitMQ", $descr="Topic exchange skillswap.events: transactional outbox relay, idempotent consumers, DLQ (ADR-013)", $tags="", $link="")
  Container(SkillSwapSystem.Gateway, "Gateway", $techn="NestJS (Node.js)", $descr="Public REST entry point: JWT, trusted identity, rate limiting, HTTP proxy :4000", $tags="", $link="")
  Container(SkillSwapSystem.BackendAPI, "Backend API", $techn="NestJS (Node.js)", $descr="Private NestJS modular monolith :4001; seven contexts; payment adapter is in-process mock", $tags="", $link="")
}

Rel(SkillSwapSystem.Gateway, SkillSwapSystem.BackendAPI, "1: POST /api/classes/:id/bookings (API client)", $techn="HTTP/JSON", $tags="", $link="")
Rel(SkillSwapSystem.BackendAPI, SkillSwapSystem.Database, "2: Own live_class transaction: guard capacity, Pending hold 15 min", $techn="TypeORM", $tags="", $link="")
Rel(SkillSwapSystem.Gateway, SkillSwapSystem.BackendAPI, "3: POST /api/classes/bookings/:bookingId/confirm", $techn="HTTP/JSON", $tags="", $link="")
Rel(SkillSwapSystem.BackendAPI, SkillSwapSystem.Database, "4: Confirmed + booking.confirmed outbox atomically", $techn="TypeORM", $tags="", $link="")
Rel(SkillSwapSystem.BackendAPI, SkillSwapSystem.MessageBroker, "5: Shared relay publishes committed outbox; wallet consumer deduplicates", $techn="AMQP", $tags="", $link="")
Rel(SkillSwapSystem.BackendAPI, SkillSwapSystem.Database, "6: Own wallet_ledger transaction: debit, Teacher pending, fee", $techn="TypeORM", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml
