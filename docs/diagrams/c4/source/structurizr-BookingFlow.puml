@startuml
title Dynamic Diagram — Booking and Payment | FR-007/009

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

' Presentation only: model elements and relationships come from workspace.dsl.
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 45
skinparam footerFontSize 12
skinparam titleFontSize 20
UpdateElementStyle("person", $bgColor="#0F172A", $fontColor="#FFFFFF", $borderColor="#0F172A", $legendText="Person")
UpdateElementStyle("system", $bgColor="#047857", $fontColor="#FFFFFF", $borderColor="#047857", $legendText="Software system in scope")
UpdateElementStyle("external_system", $bgColor="#64748B", $fontColor="#FFFFFF", $borderColor="#64748B", $legendText="Supporting software system")
UpdateElementStyle("container", $bgColor="#047857", $fontColor="#FFFFFF", $borderColor="#047857", $legendText="Application or data store")
UpdateRelStyle($lineColor="#475569", $textColor="#334155")

System_Boundary("SkillSwap_boundary", "SkillSwap", $tags="") {
  Container(SkillSwap.APIgateway, "API gateway", $techn="Container: NestJS / TypeScript", $descr="Checks sign-in and forwards public requests.", $tags="", $link="")
  Container(SkillSwap.BackendAPI, "Backend API", $techn="Container: NestJS / TypeScript", $descr="Runs account, verification, class and wallet rules in one application.", $tags="", $link="")
  ContainerDb(SkillSwap.Businessdatabase, "Business database", $techn="Container: PostgreSQL / TypeORM", $descr="Stores records in seven separately owned business schemas.", $tags="", $link="")
  ContainerQueue(SkillSwap.Businessmessagebroker, "Business message broker", $techn="Container: RabbitMQ", $descr="Delivers saved business changes for background processing.", $tags="", $link="")
}

Person(User, "User", $descr="[Person]\nBooks a class using the learning capability of the account.", $tags="", $link="")

Rel(User, SkillSwap.APIgateway, "1: User asks to book a class", $techn="HTTP / JSON", $tags="", $link="")
Rel(SkillSwap.APIgateway, SkillSwap.BackendAPI, "2: Forward the booking request", $techn="HTTP / JSON", $tags="", $link="")
Rel(SkillSwap.BackendAPI, SkillSwap.Businessdatabase, "3: Check booking rules and hold a seat for 15 minutes", $techn="PostgreSQL protocol / TypeORM", $tags="", $link="")
Rel(SkillSwap.APIgateway, SkillSwap.BackendAPI, "4: Forward the User confirmation", $techn="HTTP / JSON", $tags="", $link="")
Rel(SkillSwap.BackendAPI, SkillSwap.Businessdatabase, "5: Save confirmation and a request for payment processing", $techn="PostgreSQL protocol / TypeORM", $tags="", $link="")
Rel(SkillSwap.BackendAPI, SkillSwap.Businessmessagebroker, "6: Publish the saved payment request", $techn="AMQP", $tags="", $link="")
Rel(SkillSwap.Businessmessagebroker, SkillSwap.BackendAPI, "7: Deliver the request to the wallet handler", $techn="AMQP", $tags="", $link="")
Rel(SkillSwap.BackendAPI, SkillSwap.Businessdatabase, "8: Deduct credits and allocate teaching-user income and fee together", $techn="PostgreSQL protocol / TypeORM", $tags="", $link="")

SHOW_LEGEND()
footer Current backend: confirmation is saved before wallet payment finishes (gap against BR-022/026).\nTeaching-user income stays on hold. Repeated payment processing cannot charge the booking twice.
@enduml
