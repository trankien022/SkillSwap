@startuml
title Dynamic Diagram — Review Teaching Skills | FR-004/005

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

' Presentation only: model elements and relationships come from workspace.dsl.
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 45
skinparam footerFontSize 12
skinparam titleFontSize 20
UpdateElementStyle("person", $bgColor="#0F172A", $fontColor="#FFFFFF", $borderColor="#0F172A", $legendText="Person")
UpdateElementStyle("system", $bgColor="#047857", $fontColor="#FFFFFF", $borderColor="#047857", $legendText="Software system in scope")
UpdateElementStyle("external_system", $bgColor="#64748B", $fontColor="#FFFFFF", $borderColor="#64748B", $legendText="Supporting software system")
UpdateElementStyle("container", $bgColor="#047857", $fontColor="#FFFFFF", $borderColor="#047857", $legendText="Application or data store")
UpdateRelStyle($lineColor="#475569", $textColor="#334155")
AddElementTag("Demo", $bgColor="#F1F5F9", $fontColor="#0F172A", $borderColor="#64748B", $legendText="Demonstration client (local booking data)")

System_Boundary("SkillSwap_boundary", "SkillSwap", $tags="") {
  Container(SkillSwap.APIgateway, "API gateway", $techn="Container: NestJS / TypeScript", $descr="Checks sign-in and forwards public requests.", $tags="", $link="")
  Container(SkillSwap.BackendAPI, "Backend API", $techn="Container: NestJS / TypeScript", $descr="Runs account, verification, class and wallet rules in one application.", $tags="", $link="")
  ContainerDb(SkillSwap.Businessdatabase, "Business database", $techn="Container: PostgreSQL / TypeORM", $descr="Stores records in seven separately owned business schemas.", $tags="", $link="")
  ContainerQueue(SkillSwap.Businessmessagebroker, "Business message broker", $techn="Container: RabbitMQ", $descr="Delivers saved business changes for background processing.", $tags="", $link="")
}

Person(Verifier, "Verifier", $descr="[Person]\nReviews evidence within assigned expertise.", $tags="", $link="")

Rel(Verifier, SkillSwap.APIgateway, "1: Verifier requests evidence within their expertise", $techn="HTTP / JSON", $tags="", $link="")
Rel(SkillSwap.APIgateway, SkillSwap.BackendAPI, "2: Forward the review request", $techn="HTTP / JSON", $tags="", $link="")
Rel(SkillSwap.BackendAPI, SkillSwap.Businessdatabase, "3: Read matching evidence awaiting review", $techn="PostgreSQL protocol / TypeORM", $tags="", $link="")
Rel(SkillSwap.APIgateway, SkillSwap.BackendAPI, "4: Forward the Verifier claim and decision", $techn="HTTP / JSON", $tags="", $link="")
Rel(SkillSwap.BackendAPI, SkillSwap.Businessdatabase, "5: Check assigned Verifier and save decision, level and history", $techn="PostgreSQL protocol / TypeORM", $tags="", $link="")
Rel(SkillSwap.BackendAPI, SkillSwap.Businessmessagebroker, "6: Publish the saved approval change", $techn="AMQP", $tags="", $link="")
Rel(SkillSwap.Businessmessagebroker, SkillSwap.BackendAPI, "7: Deliver the change to teaching eligibility handlers", $techn="AMQP", $tags="", $link="")
Rel(SkillSwap.BackendAPI, SkillSwap.Businessdatabase, "8: Update teaching permissions in the class records", $techn="PostgreSQL protocol / TypeORM", $tags="", $link="")

SHOW_LEGEND()
footer Only the active, expertise-matched assigned Verifier may decide.\nTeaching permission updates run in the background; they may lag behind the saved decision.
@enduml
