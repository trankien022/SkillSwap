@startuml
title <size:24>Dynamic View: SkillSwap System</size>\n<size:24>Current backend publishing and room access</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

System_Boundary("SkillSwapSystem_boundary", "SkillSwap System", $tags="") {
  ContainerDb(SkillSwapSystem.Database, "Database", $techn="PostgreSQL", $descr="One skillswap database; seven module schemas, per-module credentials; no cross-schema joins/FKs", $tags="", $link="")
  Container(SkillSwapSystem.Gateway, "Gateway", $techn="NestJS (Node.js)", $descr="Public REST entry point: JWT, trusted identity, rate limiting, HTTP proxy :4000", $tags="", $link="")
  Container(SkillSwapSystem.BackendAPI, "Backend API", $techn="NestJS (Node.js)", $descr="Private NestJS modular monolith :4001; seven contexts; payment adapter is in-process mock", $tags="", $link="")
}

Person(Teacher, "Teacher", $descr="User acting as Teacher (role=user): verified student + approved skills to publish; no payout API", $tags="", $link="")
System(Jitsiselfhosted, "Jitsi (self-hosted)", $descr="Self-hosted Jitsi Docker stack; room-scoped JWT; WebRTC media", $tags="", $link="")

Rel(SkillSwapSystem.Gateway, SkillSwapSystem.BackendAPI, "1: POST /api/classes; authenticated user acting as Teacher", $techn="HTTP/JSON", $tags="", $link="")
Rel(SkillSwapSystem.BackendAPI, SkillSwapSystem.Database, "2: Read own teacher_verified + teacher_skill_approval; require verified and every skill approved; persist Published", $techn="TypeORM", $tags="", $link="")
Rel(SkillSwapSystem.Gateway, SkillSwapSystem.BackendAPI, "3: POST /api/classes/bookings/:bookingId/room-access", $techn="HTTP/JSON", $tags="", $link="")
Rel(SkillSwapSystem.BackendAPI, SkillSwapSystem.Database, "4: Check confirmed booking, party and time window", $techn="TypeORM", $tags="", $link="")
Rel(SkillSwapSystem.BackendAPI, Jitsiselfhosted, "5: Issue locally signed short-lived room JWT", $techn="HS256 JWT", $tags="", $link="")
Rel(Teacher, Jitsiselfhosted, "6: Join using issued room URL and JWT", $techn="HTTPS/WebRTC", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml
