@startuml
title <size:24>Container View: SkillSwap System</size>\n<size:24>Container diagram showing the internal structure of SkillSwap</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include C:/Users/LENOVO/.agents/skills/plantuml-skill/assets/premium-theme.puml
skinparam backgroundcolor #ffffff
skinparam linetype polyline

Person(Learner, "Learner", $descr="Student user who searches, books, pays, attends, and reviews classes", $tags="", $link="")
Person(Teacher, "Teacher", $descr="Student teacher who submits evidence, creates classes, teaches, and withdraws earnings", $tags="", $link="")
Person(Verifier, "Verifier", $descr="Reviews and verifies teacher skills", $tags="", $link="")
Person(Administrator, "Administrator", $descr="Verifies students, manages verifiers, handles operations", $tags="", $link="")
System(PaymentGateway, "Payment Gateway", $descr="Processes payments and transactions", $tags="", $link="")
System(Jitsi, "Jitsi", $descr="Provides online classroom/video conferencing", $tags="", $link="")

System_Boundary("SkillSwapSystem_boundary", "SkillSwap System", $tags="") {
  Container(SkillSwapSystem.WebApplication, "Web Application", $techn="Next.js (React)", $descr="Frontend for learners, teachers, verifiers, and administrators", $tags="", $link="")
  Container(SkillSwapSystem.MobileApplication, "Mobile Application", $techn="Expo (React Native)", $descr="iOS/Android client for learners and teachers (planned, ADR-015)", $tags="", $link="")
  Container(SkillSwapSystem.Gateway, "Gateway", $techn="NestJS (Node.js)", $descr="Public REST entry point: auth, rate limiting, route to RPC", $tags="", $link="")
  Container(SkillSwapSystem.BackendAPI, "Backend API", $techn="NestJS (Node.js)", $descr="REST API handling business logic, authentication, and data access", $tags="", $link="")
  ContainerDb(SkillSwapSystem.Database, "Database", $techn="PostgreSQL", $descr="Stores user accounts, classes, bookings, credits, reviews, and messages", $tags="", $link="")
  Container(SkillSwapSystem.MessageBroker, "Message Broker", $techn="RabbitMQ", $descr="Topic exchange skillswap.events: transactional outbox relay, idempotent consumers, DLQ (ADR-013)", $tags="Queue", $link="")
}

Rel(Learner, SkillSwapSystem.WebApplication, "Uses", $techn="HTTPS", $tags="", $link="")
Rel(Teacher, SkillSwapSystem.WebApplication, "Uses", $techn="HTTPS", $tags="", $link="")
Rel(Verifier, SkillSwapSystem.WebApplication, "Uses", $techn="HTTPS", $tags="", $link="")
Rel(Administrator, SkillSwapSystem.WebApplication, "Uses", $techn="HTTPS", $tags="", $link="")
Rel(Learner, SkillSwapSystem.MobileApplication, "Uses", $techn="HTTPS", $tags="", $link="")
Rel(Teacher, SkillSwapSystem.MobileApplication, "Uses", $techn="HTTPS", $tags="", $link="")
Rel(Teacher, Jitsi, "Teaches live class", $techn="HTTPS/WebRTC", $tags="", $link="")
Rel(Learner, Jitsi, "Attends live class", $techn="HTTPS/WebRTC", $tags="", $link="")
Rel(SkillSwapSystem.WebApplication, SkillSwapSystem.Gateway, "Makes API calls to", $techn="HTTPS", $tags="", $link="")
Rel(SkillSwapSystem.MobileApplication, SkillSwapSystem.Gateway, "Makes API calls to", $techn="HTTPS", $tags="", $link="")
Rel(SkillSwapSystem.Gateway, SkillSwapSystem.BackendAPI, "Forwards requests to", $techn="REST/JSON", $tags="", $link="")
Rel(SkillSwapSystem.BackendAPI, SkillSwapSystem.Database, "Reads/writes to", $techn="TypeORM", $tags="", $link="")
Rel(SkillSwapSystem.BackendAPI, SkillSwapSystem.MessageBroker, "Publishes integration events via outbox", $techn="AMQP", $tags="", $link="")
Rel(SkillSwapSystem.BackendAPI, PaymentGateway, "Processes payments via", $techn="REST/JSON", $tags="", $link="")
Rel(SkillSwapSystem.BackendAPI, Jitsi, "Creates/joins classroom via", $techn="HTTPS/WebRTC", $tags="", $link="")


SHOW_LEGEND(true)
hide stereotypes
@enduml
