@startuml
title <size:24>Container View: SkillSwap System</size>\n<size:24>Container diagram showing the internal structure of SkillSwap</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

Person(Learner, "Learner", $descr="User acting as Learner (role=user): booking, wallet, verification; booking UI mocked", $tags="", $link="")
Person(Teacher, "Teacher", $descr="User acting as Teacher (role=user): verified student + approved skills to publish; no payout API", $tags="", $link="")
Person(Verifier, "Verifier", $descr="Provisioned role=verifier; active matching expertise and claim required", $tags="", $link="")
Person(Administrator, "Administrator", $descr="Provisioned role=admin; student decisions, Verifier access status", $tags="", $link="")
System(Privatedocumentstorage, "Private document storage", $descr="S3-compatible MinIO in Docker; presigned uploads", $tags="", $link="")
System(Jitsiselfhosted, "Jitsi (self-hosted)", $descr="Self-hosted Jitsi Docker stack; room-scoped JWT; WebRTC media", $tags="", $link="")

System_Boundary("SkillSwapSystem_boundary", "SkillSwap System", $tags="") {
  ContainerDb(SkillSwapSystem.Database, "Database", $techn="PostgreSQL", $descr="One skillswap database; seven module schemas, per-module credentials; no cross-schema joins/FKs", $tags="", $link="")
  ContainerQueue(SkillSwapSystem.MessageBroker, "Message Broker", $techn="RabbitMQ", $descr="Topic exchange skillswap.events: transactional outbox relay, idempotent consumers, DLQ (ADR-013)", $tags="", $link="")
  Container(SkillSwapSystem.WebApplication, "Web Application", $techn="Next.js (React)", $descr="Web scaffold; HTTP health/status UI; booking UI uses local mock", $tags="", $link="")
  Container(SkillSwapSystem.MobileApplication, "Mobile Application", $techn="Expo (React Native)", $descr="Expo client scaffold; booking UI uses local mock, not Backend API (ADR-015)", $tags="", $link="")
  Container(SkillSwapSystem.Gateway, "Gateway", $techn="NestJS (Node.js)", $descr="Public REST entry point: JWT, trusted identity, rate limiting, HTTP proxy :4000", $tags="", $link="")
  Container(SkillSwapSystem.BackendAPI, "Backend API", $techn="NestJS (Node.js)", $descr="Private NestJS modular monolith :4001; seven contexts; payment adapter is in-process mock", $tags="", $link="")
}

Rel(Learner, SkillSwapSystem.WebApplication, "Health/status UI and local mock booking", $techn="Browser", $tags="", $link="")
Rel(Teacher, SkillSwapSystem.WebApplication, "Web scaffold; role workflows incomplete", $techn="Browser", $tags="", $link="")
Rel(Verifier, SkillSwapSystem.Gateway, "Queue, claim and decision via API client", $techn="HTTPS/REST", $tags="", $link="")
Rel(Administrator, SkillSwapSystem.Gateway, "Student decisions and Verifier status via API client", $techn="HTTPS/REST", $tags="", $link="")
Rel(Learner, SkillSwapSystem.MobileApplication, "Local mock booking UI", $techn="Native UI", $tags="", $link="")
Rel(Teacher, SkillSwapSystem.MobileApplication, "Native scaffold; role workflows incomplete", $techn="Native UI", $tags="", $link="")
Rel(Learner, SkillSwapSystem.Gateway, "Booking, wallet and verification via API client", $techn="HTTPS/REST", $tags="", $link="")
Rel(Teacher, SkillSwapSystem.Gateway, "Class and evidence commands via API client", $techn="HTTPS/REST", $tags="", $link="")
Rel(Learner, Privatedocumentstorage, "Upload document bytes using API-issued URL", $techn="Presigned HTTPS PUT", $tags="", $link="")
Rel(Teacher, Jitsiselfhosted, "Teaches live class", $techn="HTTPS/WebRTC", $tags="", $link="")
Rel(Learner, Jitsiselfhosted, "Attends live class", $techn="HTTPS/WebRTC", $tags="", $link="")
Rel(SkillSwapSystem.WebApplication, SkillSwapSystem.Gateway, "Health/status HTTP calls only; booking uses local mock", $techn="HTTPS/REST", $tags="", $link="")
Rel(SkillSwapSystem.Gateway, SkillSwapSystem.BackendAPI, "Forwards requests to", $techn="HTTP/JSON", $tags="", $link="")
Rel(SkillSwapSystem.BackendAPI, SkillSwapSystem.Database, "Reads from and writes to", $techn="TypeORM", $tags="", $link="")
Rel(SkillSwapSystem.BackendAPI, SkillSwapSystem.MessageBroker, "Publishes integration events via outbox", $techn="AMQP", $tags="", $link="")
Rel(SkillSwapSystem.BackendAPI, Jitsiselfhosted, "Signs scoped JWT locally; client joins Jitsi", $techn="HS256 JWT", $tags="", $link="")
Rel(SkillSwapSystem.BackendAPI, Privatedocumentstorage, "Signs presigned upload URL locally", $techn="S3 Signature V4", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml
