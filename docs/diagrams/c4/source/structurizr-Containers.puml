@startuml
title C4-L1 Container Diagram — SkillSwap (C4 standard Level 2)

set separator none
top to bottom direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

' Presentation only: model elements and relationships come from workspace.dsl.
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam nodesep 35
skinparam ranksep 45
skinparam footerFontSize 12
skinparam titleFontSize 20
UpdateElementStyle("person", $bgColor="#0F172A", $fontColor="#FFFFFF", $borderColor="#0F172A", $legendText="Person")
UpdateElementStyle("system", $bgColor="#047857", $fontColor="#FFFFFF", $borderColor="#047857", $legendText="Software system in scope")
UpdateElementStyle("external_system", $bgColor="#64748B", $fontColor="#FFFFFF", $borderColor="#64748B", $legendText="Supporting software system")
UpdateElementStyle("container", $bgColor="#047857", $fontColor="#FFFFFF", $borderColor="#047857", $legendText="Application or data store")
UpdateRelStyle($lineColor="#475569", $textColor="#334155")

Person(AccountHolder, "Account holder", $descr="[Person]\nUses the web or mobile client, or role-authorized API services.", $tags="", $link="")
System_Ext(Onlineclassroom, "Online classroom", $descr="[Supporting software system]\nHosts live lessons for users who are learning or teaching.", $tags="", $link="")
System_Ext(Paymentgateway, "SePay Payment Gateway", $descr="[Supporting software system]\nProcesses cash top-ups through a hosted checkout page and reports the outcome by IPN. Payout is not implemented.", $tags="", $link="")

System_Boundary("SkillSwap_boundary", "SkillSwap", $tags="") {
  Container(SkillSwap.APIgateway, "API gateway", $techn="Container: NestJS / TypeScript", $descr="Checks sign-in and forwards public requests.", $tags="", $link="")
  Container(SkillSwap.BackendAPI, "Backend API", $techn="Container: NestJS / TypeScript", $descr="Runs account, verification, class and wallet rules in one application.", $tags="", $link="")
  ContainerDb(SkillSwap.Businessdatabase, "Business database", $techn="Container: PostgreSQL / TypeORM", $descr="Stores records in seven separately owned business schemas.", $tags="", $link="")
  ContainerQueue(SkillSwap.Businessmessagebroker, "Business message broker", $techn="Container: RabbitMQ", $descr="Delivers saved business changes for background processing.", $tags="", $link="")
  ContainerDb(SkillSwap.Privatedocumentstore, "Private document store", $techn="Container: MinIO / S3-compatible API", $descr="Stores student proof uploaded through temporary private links.", $tags="", $link="")
  Container(SkillSwap.Webapplication, "Web application", $techn="Container: Next.js / TypeScript", $descr="Learns, publishes classes, manages the wallet and submits verification evidence.", $tags="", $link="")
  Container(SkillSwap.Mobileapplication, "Mobile application", $techn="Container: Expo / React Native", $descr="The same learner and teacher screens as the web client.", $tags="", $link="")
}

Rel(AccountHolder, SkillSwap.Webapplication, "Learns, teaches and manages the wallet", $techn="Browser", $tags="", $link="")
Rel(AccountHolder, SkillSwap.Mobileapplication, "Uses the same learner and teacher screens", $techn="Native UI", $tags="", $link="")
Rel(AccountHolder, SkillSwap.APIgateway, "Requests services allowed for their account", $techn="HTTP / JSON", $tags="", $link="")
Rel(AccountHolder, SkillSwap.Privatedocumentstore, "Uploads owned student proof using a temporary link", $techn="HTTP PUT", $tags="", $link="")
Rel(AccountHolder, Onlineclassroom, "Joins a booked lesson with a private invitation", $techn="HTTPS / WebRTC", $tags="", $link="")
Rel(SkillSwap.Webapplication, SkillSwap.APIgateway, "Sends every feature request", $techn="HTTP / JSON", $tags="", $link="")
Rel(SkillSwap.APIgateway, SkillSwap.BackendAPI, "Forwards authenticated requests", $techn="HTTP / JSON", $tags="", $link="")
Rel(SkillSwap.BackendAPI, SkillSwap.Businessdatabase, "Reads and saves owned business records", $techn="PostgreSQL protocol / TypeORM", $tags="", $link="")
Rel(SkillSwap.BackendAPI, SkillSwap.Businessmessagebroker, "Publishes saved business changes", $techn="AMQP", $tags="", $link="")
Rel(SkillSwap.Businessmessagebroker, SkillSwap.BackendAPI, "Delivers changes to background handlers", $techn="AMQP", $tags="", $link="")
Rel(SkillSwap.BackendAPI, Paymentgateway, "Starts top-ups through the PaymentGateway port", $techn="HTTPS / signed checkout form", $tags="", $link="")
Rel(Paymentgateway, SkillSwap.APIgateway, "Reports the payment outcome", $techn="HTTPS / IPN (IP allow-list)", $tags="", $link="")

Lay_R(AccountHolder, Onlineclassroom)
Lay_R(SkillSwap.Webapplication, SkillSwap.Mobileapplication)
Lay_D(SkillSwap.APIgateway, SkillSwap.BackendAPI)
Lay_R(SkillSwap.Businessdatabase, SkillSwap.Businessmessagebroker)
Lay_R(SkillSwap.Privatedocumentstore, Onlineclassroom)
SHOW_LEGEND()
footer Current implementation: web and mobile booking screens call the real hold and confirm endpoints and PaymentGateway is backed by the SePay Payment Gateway adapter (hosted checkout + IPN, ADR-033); payout is not implemented.\nBackend signs classroom invitations and document upload links locally. No network call to Jitsi/MinIO is implied.\nHTTP labels describe local development; production ingress is HTTPS. The web app connects to the API for every feature screen, not only status calls.
@enduml
