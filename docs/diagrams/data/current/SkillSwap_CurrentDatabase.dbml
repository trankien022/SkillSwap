  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  revoked_at timestamptz
  revocation_reason text
  indexes {
    (account_id, status) [name: 'ix_student_verifications_account_status']
    (id) [name: 'student_verifications_pkey', pk]
  }
  Note: 'Owner module: student_verification. CHECK ((status = ANY (ARRAY[\'pending\'::text, \'approved\'::text, \'rejected\'::text, \'revoked\'::text]))); CREATE UNIQUE INDEX uq_student_verifications_effective ON student_verification.student_verifications USING btree (account_id) WHERE (status = ANY (ARRAY[\'pending\'::text, \'approved\'::text]))'
}

Table student_verification.verification_documents {
  id uuid [not null, default: `gen_random_uuid()`]
  account_id text [not null]
  object_key text [not null]
  file_name text [not null]
  content_type text [not null]
  size_bytes bigint [not null]
  status text [not null, default: `'pending'::text`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (account_id, status) [name: 'ix_verification_documents_account']
    (id) [name: 'verification_documents_pkey', pk]
  }
  Note: 'Owner module: student_verification. CHECK ((size_bytes > 0)); CHECK ((status = ANY (ARRAY[\'pending\'::text, \'attached\'::text])))'
}

Table wallet_ledger.ledger_entries {
  id bigint [not null, increment]
  booking_id text
  teacher_id text [not null]
  amount_credits integer [not null]
  direction text [not null]
  created_at timestamptz [not null, default: `now()`]
  entry_type text [not null, default: `'teacher_credit'::text`]
  owner_id text
  reference_id text
  trace_id text
  release_key text
  indexes {
    (id) [name: 'ledger_entries_pkey', pk]
  }
  Note: 'Owner module: wallet_ledger. CHECK ((amount_credits > 0)); CHECK ((direction = ANY (ARRAY[\'credit\'::text, \'debit\'::text]))); CREATE UNIQUE INDEX uq_ledger_release_key ON wallet_ledger.ledger_entries USING btree (entry_type, reference_id, release_key) WHERE ((entry_type = \'release\'::text) AND (release_key IS NOT NULL)); CREATE UNIQUE INDEX uq_ledger_settlement_per_booking ON wallet_ledger.ledger_entries USING btree (entry_type, reference_id) WHERE (entry_type = ANY (ARRAY[\'learner_debit\'::text, \'teacher_pending\'::text, \'platform_fee\'::text, \'teacher_credit\'::text]))'
}

Table wallet_ledger.module_status {
  id integer [not null]
  state text [not null]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (id) [name: 'module_status_pkey', pk]
  }
  Note: 'Owner module: wallet_ledger. CHECK ((id = 1))'
}

Table wallet_ledger.outbox_messages {
  id uuid [not null, default: `gen_random_uuid()`]
  event_type text [not null]
  payload jsonb [not null]
  status text [not null, default: `'PENDING'::text`]
  attempts integer [not null, default: `0`]
  last_error text
  created_at timestamptz [not null, default: `now()`]
  published_at timestamptz
  indexes {
    (status, created_at) [name: 'ix_outbox_messages_status_created']
    (id) [name: 'outbox_messages_pkey', pk]
  }
  Note: 'Owner module: wallet_ledger. CHECK ((status = ANY (ARRAY[\'PENDING\'::text, \'PUBLISHED\'::text, \'DEAD\'::text])))'
}

Table wallet_ledger.processed_events {
  id text [not null]
  status text [not null, default: `'PROCESSING'::text`]
  error text
  created_at timestamptz [not null, default: `now()`]
  processed_at timestamptz
  indexes {
    (id) [name: 'processed_events_pkey', pk]
  }
  Note: 'Owner module: wallet_ledger. CHECK ((status = ANY (ARRAY[\'PROCESSING\'::text, \'DONE\'::text, \'FAILED\'::text])))'
}

Table wallet_ledger.top_up_intents {
  id uuid [not null, default: `gen_random_uuid()`]
  owner_id text [not null]
  provider text [not null]
  provider_ref text [not null]
  amount_vnd integer [not null]
  amount_credits integer [not null]
  status text [not null, default: `'pending'::text`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (owner_id) [name: 'ix_top_up_intents_owner']
    (id) [name: 'top_up_intents_pkey', pk]
    (provider, provider_ref) [name: 'uq_top_up_intents_provider_ref', unique]
  }
  Note: 'Owner module: wallet_ledger. CHECK ((amount_credits > 0)); CHECK ((amount_vnd > 0)); CHECK ((status = ANY (ARRAY[\'pending\'::text, \'settled\'::text, \'failed\'::text, \'reversed\'::text])))'
}

Table wallet_ledger.wallets {
  owner_id text [not null]
  available_credits integer [not null, default: `0`]
  pending_credits integer [not null, default: `0`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (owner_id) [name: 'wallets_pkey', pk]
  }
  Note: 'Owner module: wallet_ledger. CHECK ((pending_credits >= 0))'
}

Ref: account_profile.accounts.(id) - account_profile.account_credentials.(account_id) [delete: cascade]
Ref: account_profile.push_deliveries.(device_id) > account_profile.notification_devices.(id) [delete: cascade]
Ref: account_profile.push_deliveries.(notification_id) > account_profile.inbox_notifications.(id) [delete: cascade]
Ref: account_profile.sessions.(account_id) > account_profile.accounts.(id) [delete: cascade]
Ref: live_class.bookings.(class_id) > live_class.classes.(id)
Ref: live_class.class_skills.(class_id) > live_class.classes.(id) [delete: cascade]
Ref: live_class.bookings.(id) - live_class.ratings.(booking_id)
Ref: live_class.ratings.(class_id) > live_class.classes.(id)
Ref: skill_verification.skill_evidence.(profile_skill_id) > skill_verification.profile_skills.(id) [delete: cascade]
Ref: skill_verification.verifier_expertise.(account_id) > skill_verification.verifiers.(account_id) [delete: cascade]

TableGroup account_profile {
  account_profile.account_credentials
  account_profile.account_verification_status
  account_profile.accounts
  account_profile.inbox_notifications
  account_profile.module_status
  account_profile.notification_devices
  account_profile.outbox_messages
  account_profile.processed_events
  account_profile.push_deliveries
  account_profile.sessions
}

