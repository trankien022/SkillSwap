// SkillSwap MVP conceptual model. Business entities and cardinalities only.
// Source: docs/intent.md, PRD section 9, SRS Appendix B.
Project SkillSwap_Conceptual {
  Note: 'Business view of the MVP; attributes, keys, and storage choices are in the logical model.'
}

Table Account {
  id uuid [pk]
  role varchar [not null, note: 'user | verifier | admin — exactly one role per account (ADR-030)']
  status varchar [not null, note: 'active | suspended']
  Note: 'A single role per account. Self-registration creates only an ordinary user; verifier/admin accounts are operator-provisioned. Per BR-063 one account can both learn and teach — Learner/Teacher are capabilities, not roles; teaching is gated on verified-student status and an approved skill.'
}

Table Verifier {
  account_id uuid [pk]
  status varchar [not null, note: 'active | suspended | revoked']
  Note: 'A reviewer account with a seeded expertise set of skills (from the taxonomy). Expertise scopes the pending queue and the decision authority; no admin assignment and no self-service (ADR-027).'
}

Table VerifierExpertise {
  account_id uuid [not null]
  skill_id uuid [not null]
  indexes { (account_id, skill_id) [pk] }
  Note: 'The skills a Verifier is competent to review. Seeded; a Verifier may hold several skills (ADR-027).'
}

Table StudentVerification {
  id uuid [pk]
  profile_id uuid [not null]
  school_id uuid [not null]
  major_id uuid [not null]
  status varchar
  Note: 'Keep each immutable submission; approvals can be superseded, revoked or expired, with structured decision history.'
}

Table Skill {
  id uuid [pk]
  category varchar [not null]
  Note: 'A skill in the managed two-level category → skill catalogue, admin-seeded (OQ-001 resolved, ADR-026).'
}

Table Profile {
  id uuid [pk]
  account_id uuid [not null, unique]
  school_id uuid
  major_id uuid
  Note: 'One profile per Account; school and major may be absent for provisioned non-student roles.'
}

Table School {
  id uuid [pk]
}

Table Major {
  id uuid [pk]
}

Table SchoolMajor {
  school_id uuid
  major_id uuid
  indexes { (school_id, major_id) [pk] }
}

Table ProfileSkill {
  id uuid [pk]
  profile_id uuid [not null]
  skill_id uuid [not null]
  level varchar [note: 'Cached effective approved level: beginner | intermediate | advanced | expert; NULL until approved']
  Note: 'Many skills per profile. Valid SkillEvidence.approved_level controls teaching permission. Pending upgrades retain the old valid approval; a new approval updates the cache atomically.'
}

Table SkillEvidence {
  id uuid [pk]
  profile_skill_id uuid [not null]
  evidence_type varchar [note: 'certificate | verifier_assessment']
  status varchar
  requested_level varchar
  approved_level varchar
  claimed_by uuid
  claimed_at timestamp
  reviewer_id uuid
  Note: 'Only an active, expertise-matched Verifier (not Admin, not the owner) reviews. A distinct claim locks the row to one Verifier permanently (no release, ADR-027). Preserve versions and old/new decision audit; the claim is a state on the row, not an assignment entity.'
}

Table Class {
  id uuid [pk]
  teacher_id uuid [not null]
  Note: 'One Class is one scheduled online session. Teacher, content, schedule and ClassSkills are frozen at the first confirmed Booking; completion records time and audited source/rule.'
}

Table ClassSkill {
  class_id uuid [not null]
  skill_id uuid [not null]
  target_level varchar [note: 'begin | mid | senior']
  indexes { (class_id, skill_id) [pk] }
  Note: 'Class covers one or more skills, each approved for its Teacher at a sufficient level.'
}

Table Booking {
  id uuid [pk]
  class_id uuid [not null]
  learner_id uuid [not null]
  Note: 'At most one valid Booking per Learner/Class; capacity and payment are committed atomically. One full income release operation per Booking.'
}

Table Wallet {
  id uuid [pk]
  owner_id uuid [unique]
  Note: 'At most one user wallet per User; system wallets have no User owner. Balances derive from available, pending and payout_hold postings.'
}

Table LedgerTransaction {
  id uuid [pk]
  initiated_by_user_id uuid
  booking_id uuid
  withdrawal_request_id uuid
  reverses_transaction_id uuid [unique, note: 'Only full reversal refers to an original; at most one full reversal per original.']
  kind varchar [note: 'top_up | booking | release | withdrawal_hold | withdrawal | withdrawal_release | reversal']
  Note: 'Balanced transfers also obey kind-specific participants/amounts. Top-up is a kind. One withdrawal request groups hold, payout/release and authorized compensations; retries reuse the business operation.'
}

Table LedgerPosting {
  id uuid [pk]
  transaction_id uuid [not null]
  wallet_id uuid [not null]
  user_id uuid
  class_id uuid
  bucket varchar [not null, note: 'available | pending | payout_hold']
  Note: 'User is wallet owner (NULL for system wallets); Class is present for booking transfers. Payout holds cannot be spent; posted amounts remain immutable, including reversed originals.'
}

Table WithdrawalRequest {
  id uuid [pk]
  teacher_id uuid [not null]
  Note: 'Has many LedgerTransactions; hold credit before payout. Timeout retains the hold until a definitive result or reconciliation. Successful payout and failure hold release are mutually exclusive.'
}

Table Message {
  id uuid [pk]
  class_id uuid [not null]
  sender_id uuid [not null]
}

Table Rating {
  id uuid [pk]
  booking_id uuid [not null, unique]
  Note: 'A Booking has zero or one Rating; only its eligible Learner may review a completed Class.'
}

Ref: Account.id - Profile.account_id
Ref: School.id < Profile.school_id
Ref: Major.id < Profile.major_id
Ref: School.id < SchoolMajor.school_id
Ref: Major.id < SchoolMajor.major_id
Ref: Profile.id < StudentVerification.profile_id
Ref: School.id < StudentVerification.school_id
Ref: Major.id < StudentVerification.major_id
Ref: Profile.id < ProfileSkill.profile_id
Ref: Skill.id < ProfileSkill.skill_id
Ref: ProfileSkill.id < SkillEvidence.profile_skill_id
Ref: Account.id < SkillEvidence.reviewer_id
Ref: Account.id < Class.teacher_id
Ref: Class.id < ClassSkill.class_id
Ref: Skill.id < ClassSkill.skill_id
Ref: Class.id < Booking.class_id
Ref: Account.id < Booking.learner_id
Ref: Account.id - Wallet.owner_id
Ref: LedgerTransaction.id < LedgerPosting.transaction_id
Ref: Wallet.id < LedgerPosting.wallet_id
Ref: Account.id < LedgerPosting.user_id
Ref: Class.id < LedgerPosting.class_id
Ref: Account.id < LedgerTransaction.initiated_by_user_id
Ref: Booking.id < LedgerTransaction.booking_id
Ref: Account.id < WithdrawalRequest.teacher_id
Ref: WithdrawalRequest.id < LedgerTransaction.withdrawal_request_id
Ref: LedgerTransaction.reverses_transaction_id - LedgerTransaction.id
Ref: Class.id < Message.class_id
Ref: Account.id < Message.sender_id
Ref: Booking.id - Rating.booking_id
