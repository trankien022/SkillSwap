@startuml
title <size:24>Dynamic View: SkillSwap System</size>\n<size:24>Verifier reviews teacher skills</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

System_Boundary("SkillSwapSystem_boundary", "SkillSwap System", $tags="") {
  Container(SkillSwapSystem.WebApplication, "Web Application", $techn="TBD (React/Next.js/Vue)", $descr="Frontend for learners, teachers, verifiers, and administrators", $tags="", $link="")
  Container(SkillSwapSystem.BackendAPI, "Backend API", $techn="TBD (Node.js/Express/Python/FastAPI)", $descr="REST API handling business logic, authentication, and data access", $tags="", $link="")
  ContainerDb(SkillSwapSystem.Database, "Database", $techn="PostgreSQL", $descr="Stores user accounts, classes, bookings, credits, reviews, and messages", $tags="", $link="")
}

Person(Verifier, "Verifier", $descr="Reviews and verifies teacher skills", $tags="", $link="")

Rel(Verifier, SkillSwapSystem.WebApplication, "1: Reviews teacher evidence", $techn="HTTPS", $tags="", $link="")
Rel(SkillSwapSystem.WebApplication, SkillSwapSystem.BackendAPI, "2: GET /verifications", $techn="REST/JSON", $tags="", $link="")
Rel(SkillSwapSystem.BackendAPI, SkillSwapSystem.Database, "3: Read teacher skills", $techn="JDBC", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml