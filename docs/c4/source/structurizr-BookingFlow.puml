@startuml
title <size:24>Dynamic View: SkillSwap System</size>\n<size:24>Learner books and attends a class</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

System_Boundary("SkillSwapSystem_boundary", "SkillSwap System", $tags="") {
  Container(SkillSwapSystem.WebApplication, "Web Application", $techn="Next.js (React)", $descr="Frontend for learners, teachers, verifiers, and administrators", $tags="", $link="")
  Container(SkillSwapSystem.BackendAPI, "Backend API", $techn="NestJS (Node.js)", $descr="REST API handling business logic, authentication, and data access", $tags="", $link="")
  ContainerDb(SkillSwapSystem.Database, "Database", $techn="PostgreSQL", $descr="Stores user accounts, classes, bookings, credits, reviews, and messages", $tags="", $link="")
}

Person(Learner, "Learner", $descr="Student user who searches, books, pays, attends, and reviews classes", $tags="", $link="")
System(PaymentGateway, "Payment Gateway", $descr="Processes payments and transactions", $tags="", $link="")
System(Jitsi, "Jitsi", $descr="Provides online classroom/video conferencing", $tags="", $link="")

Rel(Learner, SkillSwapSystem.WebApplication, "1: Searches & books class", $techn="HTTPS", $tags="", $link="")
Rel(SkillSwapSystem.WebApplication, SkillSwapSystem.BackendAPI, "2: POST /bookings", $techn="REST/JSON", $tags="", $link="")
Rel(SkillSwapSystem.BackendAPI, SkillSwapSystem.Database, "3: Persist booking", $techn="TypeORM/Prisma", $tags="", $link="")
Rel(SkillSwapSystem.BackendAPI, PaymentGateway, "4: Process payment", $techn="REST/JSON", $tags="", $link="")
Rel(SkillSwapSystem.BackendAPI, Jitsi, "5: Create classroom (returns URL)", $techn="HTTPS/WebRTC", $tags="", $link="")
Rel(Learner, Jitsi, "6: Joins classroom", $techn="HTTPS/WebRTC", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml