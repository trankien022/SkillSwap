{
  "expo": {
    "name": "SkillSwap",
    "slug": "skillswap",
    "scheme": "skillswap",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "./plugins/with-jitsi-android"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.skillswap.app",
      "infoPlist": {
        "NSCameraUsageDescription": "SkillSwap uses your camera during live lessons.",
        "NSMicrophoneUsageDescription": "SkillSwap uses your microphone during live lessons.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.skillswap.app",
      "permissions": ["CAMERA", "RECORD_AUDIO"]
    },
    "extra": {
      "eas": {
        "projectId": "35945ae4-740f-4477-99f4-c824b74a4fe5"
      },
      "router": {}
    },
    "owner": "trankienqt02"
  }
}
