# For the Mac AVD, run `adb reverse tcp:4000 tcp:4000` and use localhost below.
# The Android host bridge `http://10.0.2.2:4000` also works without adb reverse.
# Add `adb reverse tcp:9000 tcp:9000` when local signed MinIO URLs use localhost:9000.
# A physical phone needs a Gateway URL reachable over the local network or HTTPS.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
# Set to the UUID of the linked Expo/EAS project before requesting a push token.
# EXPO_PUBLIC_EAS_PROJECT_ID=
# Add the Firebase Android app config as apps/mobile/google-services.json (ignored by Git).
# Keep the FCM service-account key outside the repository; upload it to EAS credentials.
