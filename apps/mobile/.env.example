# iOS Simulator uses Mac localhost. For an Android emulator, use http://10.0.2.2:4000.
# A physical phone needs a Gateway URL reachable over the local network or HTTPS.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
# Set after linking the real Expo/EAS project; never invent a project UUID.
# EXPO_PUBLIC_EAS_PROJECT_ID=
